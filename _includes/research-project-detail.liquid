{% assign project = site.data.research_projects | where: 'id', page.project_id | first %}
{% assign area = site.data.research_areas | where: 'id', project.area | first %}
{% assign publication_count = project.publications | size %}

<link rel="stylesheet" href="{{ '/assets/css/research-projects.css' | relative_url }}">

<div class="research-project-detail">
  <a class="research-projects__back" href="{{ area.url | relative_url }}#{{ project.id }}">
    <span aria-hidden="true">&larr;</span> {{ area.title | escape }}
  </a>

  {% if project.publications %}
    <header class="research-project-hero{% if publication_count > 1 %} research-project-hero--versions{% endif %}">
      {% if publication_count > 1 %}
        <h1 class="research-project-hero__name">{{ project.title | escape }}</h1>
      {% else %}
        <p class="research-project-hero__name">{{ project.title | escape }}</p>
      {% endif %}
      <div class="research-project-hero__publications">
        {% for publication in project.publications %}
          {% assign publication_authors = publication.authors | replace: ', and ', ', ' | replace: ' and ', ', ' | split: ', ' %}
          <div class="research-project-hero__publication">
            {% if publication_count > 1 and publication.version %}
              <p class="research-project-hero__version">{{ publication.version | escape }}</p>
            {% endif %}
            {% if publication_count > 1 %}
              <h2 class="research-project-hero__title">{{ publication.title | escape }}</h2>
            {% else %}
              <h1 class="research-project-hero__title">{{ publication.title | escape }}</h1>
            {% endif %}
            <ul class="research-project-hero__authors" aria-label="Authors">
              {% for author in publication_authors %}
                <li>{{ author | strip | escape }}</li>
              {% endfor %}
            </ul>
            <p class="research-project-hero__venue">
              <span>{{ publication.venue | escape }} · {{ publication.year }}</span>
              {% if publication.status %}
                <span class="research-project-hero__status">{{ publication.status | escape }}</span>
              {% endif %}
            </p>
          </div>
        {% endfor %}
      </div>
      {% if project.source_url %}
        <a class="research-project-hero__source" href="{{ project.source_url | escape }}" target="_blank" rel="noopener noreferrer">
          Original Project Page <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </header>
  {% endif %}

  {% if project.publication_label and project.publications == null %}
    <p class="research-project-card__publication">{{ project.publication_label | escape }}</p>
  {% endif %}

  {% if project.content_include %}
    <div class="research-content">
      {% include {{ project.content_include }} %}
    </div>
  {% endif %}

  {% if project.source_url %}
    <p class="research-content__source">
      Figures, demonstrations, and research details:
      <a href="{{ project.source_url }}" target="_blank" rel="noopener noreferrer">author's project page</a>.
    </p>
  {% endif %}

  <a class="research-project-detail__footer" href="{{ area.url | relative_url }}"
    >Explore more in {{ area.title | escape }}
    <span aria-hidden="true">&rarr;</span></a
  >
</div>
