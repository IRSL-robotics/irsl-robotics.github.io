{% assign research_projects = site.data.research_projects
  | where: 'published', true
  | where: 'area', page.research_area
  | sort: 'publication_sort'
  | reverse
%}

<link rel="stylesheet" href="{{ '/assets/css/research-projects.css' | relative_url }}">

<div class="research-projects">
  <a class="research-projects__back" href="{{ '/research/' | relative_url }}"> <span aria-hidden="true">&larr;</span> All research areas </a>

  <section aria-label="Research projects">
    <div class="research-projects__grid">
      {% for project in research_projects %}
        {% assign project_url = '/research/projects/' | append: project.id | append: '/' %}
        {% assign media_path = '/assets/video/research/' | append: project.id %}
        <article class="research-project-card" id="{{ project.id }}" aria-labelledby="{{ project.id }}-title">
          <a class="research-project-card__link" href="{{ project_url | relative_url }}" aria-labelledby="{{ project.id }}-title">
            <div class="research-project-card__media" data-research-preview>
              <video
                width="960"
                height="540"
                poster="{{ media_path | append: '.jpg' | relative_url }}"
                preload="none"
                muted
                loop
                playsinline
                aria-label="{{ project.title | escape }} demonstration: {{ project.subtitle | escape }}"
              >
                <source src="{{ media_path | append: '.mp4' | relative_url }}" type="video/mp4">
              </video>
            </div>
            <div class="research-project-card__body">
              <p class="research-project-card__publication">{{ project.publication_label | default: 'Ongoing project' | escape }}</p>
              <h2 id="{{ project.id }}-title">{{ project.title | escape }}</h2>
              <p class="research-project-card__subtitle">{{ project.subtitle | escape }}</p>
              <p class="research-project-card__description">{{ project.description | escape }}</p>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </section>
</div>

<script src="{{ '/assets/js/research-projects.js' | relative_url }}" defer></script>
